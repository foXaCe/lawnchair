{
    rollbackPrs: false,
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
    ],
    labels: [
        'dependencies',
    ],
    packageRules: [
        {
            groupName: 'Kotlin and KSP',
            matchPackageNames: [
                'com.google.devtools.ksp{/,}**',
                '/org.jetbrains.kotlin.*/'
            ],
        },
        {
            groupName: 'AGP',
            matchPackageNames: [
                '/com.android.*/',
            ],
        },
        {
            groupName: 'dev.rikka.tools.refine',
            matchPackageNames: [
                'dev.rikka.tools.refine{/,}**',
            ],
        },
        {
            groupName: 'androidx.lifecycle',
            matchPackageNames: [
                '/androidx.lifecycle:*/',
            ],
        },
        {
            groupName: 'Dagger',
            matchPackageNames: [
                'com.google.dagger{/,}**',
            ],
        },
        {
            description: "Tout ce qui monte se fusionne seul quand la CI est verte (opérateur, 2026-10-14)",
            matchUpdateTypes: ["minor", "major"],
            automerge: true,
            platformAutomerge: true
        }
    ],
}
